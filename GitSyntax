## 🧰 Most Used GitHub Git Commands – Reusable Bash Reference

# 🔍 Check current branch
    git branch

# 🧭 Switch to a branch
    git checkout <branch-name>

# 🆕 Create and switch to a new branch
    git checkout -b <new-branch-name>

# 📥 Clone a GitHub repository
    git clone https://github.com/<user>/<repo>.git

# 🔄 Fetch all remote updates (branches, tags)
    git fetch --all --tags

# 🔄 Pull latest changes from current branch (merge)
    git pull

# 🔄 Pull with rebase for cleaner history
    git pull --rebase

# 📤 Push current branch to GitHub
    git push origin <branch-name>

# 📤 Push all tags to GitHub
    git push --tags

# 🔄 Sync fork with upstream (if using a fork)
    git remote add upstream https://github.com/<original-owner>/<repo>.git
    git fetch upstream
    git merge upstream/main

# 📦 Stage all changes
    git add .

# 📝 Commit staged changes with a message
    git commit -m "Your commit message"

# 🧹 Undo last commit but keep changes
    git reset --soft HEAD~1

# 🧹 Discard local changes to tracked files
    git checkout -- <file>

# 🧼 Remove all untracked files and directories
    git clean -fd

# 📄 View commit history
    git log --oneline --graph --decorate --all

# 📊 Show status of working directory
    git status

# 🧠 View remote URLs
    git remote -v

# 🔗 Add a new remote
    git remote add origin https://github.com/<user>/<repo>.git

# 🧪 Test GitHub authentication
    gh auth status

# 🚀 Create a pull request (requires GitHub CLI)
    gh pr create --base main --head <branch-name> --title "PR Title" --body "PR Description"

# 📦 List GitHub issues (requires GitHub CLI)
    gh issue list

# 🧾 View GitHub repo info (requires GitHub CLI)
    gh repo view --web

